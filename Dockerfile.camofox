# syntax=docker/dockerfile:1.20
ARG CAMOFOX_BROWSER_IMAGE=ghcr.io/redf0x1/camofox-browser:latest

FROM ${CAMOFOX_BROWSER_IMAGE}

LABEL org.opencontainers.image.title="paperclip-camofox-browser"
LABEL org.opencontainers.image.description="CamoFox browser sidecar for Paperclip agents"
LABEL org.opencontainers.image.source="https://github.com/redf0x1/camofox-browser"

USER root

RUN apt-get update \
  && apt-get install -y --no-install-recommends gosu \
  && rm -rf /var/lib/apt/lists/*

COPY docker/camofox-entrypoint.sh /usr/local/bin/camofox-entrypoint.sh
RUN chmod +x /usr/local/bin/camofox-entrypoint.sh

RUN node -e "const fs=require('node:fs'); const p='/app/dist/src/routes/docs.js'; let s=fs.readFileSync(p,'utf8'); s=s.replace(\"router.get('/openapi.json', (_req, res) => {\", \"router.get(['/openapi.json', '/api/openapi.json'], (_req, res) => {\"); s=s.replace(\"url: '../openapi.json'\", \"url: '/openapi.json'\"); fs.writeFileSync(p,s);"

ENV NODE_ENV=production
ENV PORT=9377
ENV CAMOFOX_PORT=9377
ENV CAMOFOX_HOST=127.0.0.1
ENV CAMOFOX_PROFILES_DIR=/home/node/.camofox/profiles

VOLUME ["/home/node/.camofox"]
EXPOSE 9377

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD curl -fsS "http://${CAMOFOX_HOST}:${CAMOFOX_PORT}/health" >/dev/null || exit 1

ENTRYPOINT ["camofox-entrypoint.sh"]
CMD ["node", "dist/src/server.js"]
